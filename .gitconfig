[core]
  editor = nvim
  pager = delta

[credential]
  helper = store

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true
  line-numbers = true
  paging = never

[merge]
  conflictStyle = zdiff3
